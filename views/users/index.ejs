<%- include('../partials/header',{title,user}) %><h1>Utilisateurs</h1><section class="card"><h2>Ajouter</h2><form class="grid-form" action="/actions/users" method="post"><label>Nom<input name="username" required></label><label>E-mail<input type="email" name="email" required></label><label>Mot de passe<input type="password" name="password" minlength="8" required></label><button>Créer</button></form></section><section class="card"><h2>Liste</h2><div class="table-wrap"><table><thead><tr><th>Utilisateur</th><th>Modification</th><th>Suppression</th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><strong><%= u.username %></strong><br><%= u.email %></td><td><form class="grid-form compact" action="/actions/users/<%= encodeURIComponent(u.email) %>?_method=PUT" method="post"><input name="username" value="<%= u.username %>" required><input type="email" name="email" value="<%= u.email %>" required><input type="password" name="password" minlength="8" placeholder="Nouveau mot de passe (facultatif)"><button>Modifier</button></form></td><td><% if(u._id.toString()!==user.id){ %><form action="/actions/users/<%= encodeURIComponent(u.email) %>?_method=DELETE" method="post"><button class="danger">Supprimer</button></form><% } else { %><small>Compte connecté</small><% } %></td></tr><% }) %></tbody></table></div></section><%- include('../partials/footer') %>

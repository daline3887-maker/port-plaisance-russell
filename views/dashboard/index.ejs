<%- include('../partials/header',{title,user}) %><h1>Tableau de bord</h1><div class="stats"><div class="card"><span>Utilisateur</span><strong><%= user.username %></strong><small><%= user.email %></small></div><div class="card"><span>Date du jour</span><strong><%= today.toLocaleDateString('fr-FR') %></strong></div><div class="card"><span>Réservations en cours</span><strong><%= reservations.length %></strong></div></div><section class="card"><h2>Réservations en cours</h2><div class="table-wrap"><table><thead><tr><th>Catway</th><th>Client</th><th>Bateau</th><th>Début</th><th>Fin</th></tr></thead><tbody><% if(!reservations.length){ %><tr><td colspan="5">Aucune réservation en cours.</td></tr><% } reservations.forEach(r=>{ %><tr><td><%= r.catwayNumber %></td><td><%= r.clientName %></td><td><%= r.boatName %></td><td><%= r.startDate.toLocaleDateString('fr-FR') %></td><td><%= r.endDate.toLocaleDateString('fr-FR') %></td></tr><% }) %></tbody></table></div></section><%- include('../partials/footer') %>

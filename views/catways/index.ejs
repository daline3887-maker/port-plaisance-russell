<%- include('../partials/header',{title,user}) %><h1>Catways</h1><section class="card"><h2>Ajouter un catway</h2><form class="grid-form" action="/actions/catways" method="post"><label>Numéro<input type="number" min="1" name="catwayNumber" required></label><label>Type<select name="catwayType"><option value="short">short</option><option value="long">long</option></select></label><label>État<input name="catwayState" required></label><button>Créer</button></form></section><section class="card"><h2>Liste</h2><div class="table-wrap"><table><thead><tr><th>N°</th><th>Type</th><th>État / modification</th><th>Suppression</th></tr></thead><tbody><% catways.forEach(c=>{ %><tr><td><%= c.catwayNumber %></td><td><%= c.catwayType %></td><td><form class="inline" action="/actions/catways/<%= c.catwayNumber %>?_method=PUT" method="post"><input name="catwayState" value="<%= c.catwayState %>" required><button>Modifier</button></form></td><td><form action="/actions/catways/<%= c.catwayNumber %>?_method=DELETE" method="post"><button class="danger">Supprimer</button></form></td></tr><% }) %></tbody></table></div></section><%- include('../partials/footer') %>

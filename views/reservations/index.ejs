<%- include('../partials/header',{title,user}) %><h1>Réservations</h1><section class="card"><h2>Ajouter</h2><form class="grid-form" action="/actions/reservations" method="post"><label>Catway<select name="catwayNumber"><% catways.forEach(c=>{ %><option value="<%= c.catwayNumber %>"><%= c.catwayNumber %> — <%= c.catwayType %></option><% }) %></select></label><label>Client<input name="clientName" required></label><label>Bateau<input name="boatName" required></label><label>Début<input type="date" name="startDate" required></label><label>Fin<input type="date" name="endDate" required></label><button>Créer</button></form></section><section class="card"><h2>Liste</h2><div class="table-wrap"><table><thead><tr><th>Catway</th><th>Réservation</th><th>Actions</th></tr></thead><tbody><% reservations.forEach(r=>{ %><tr><td><%= r.catwayNumber %></td><td><form class="grid-form compact" action="/actions/reservations/<%= r._id %>?_method=PUT" method="post"><input name="clientName" value="<%= r.clientName %>" required><input name="boatName" value="<%= r.boatName %>" required><input type="date" name="startDate" value="<%= r.startDate.toISOString().slice(0,10) %>" required><input type="date" name="endDate" value="<%= r.endDate.toISOString().slice(0,10) %>" required><button>Modifier</button></form></td><td><form action="/actions/reservations/<%= r._id %>?_method=DELETE" method="post"><button class="danger">Supprimer</button></form></td></tr><% }) %></tbody></table></div></section><%- include('../partials/footer') %>
